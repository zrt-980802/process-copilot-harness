PC_ENVELOPE_SIGNING_KEY=replace-with-at-least-32-random-characters
PC_PILOT_TENANT_ID=tenant-local
PC_PILOT_ACCOUNT_KEY=pilot-local
PC_PILOT_ACCOUNT_SECRET=replace-with-at-least-12-characters

