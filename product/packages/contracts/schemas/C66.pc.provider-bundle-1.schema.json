{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C66.schema.json",
  "title": "C66 pc.provider-bundle/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "provider_id",
    "bundle_version",
    "registration_revision",
    "compatibility_status",
    "catalog_revision",
    "configuration_digest",
    "bundle_generation",
    "bundle_state",
    "reason_codes",
    "observed_at",
    "expires_at"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.provider-bundle/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "provider_id": {
      "type": "string",
      "pattern": "^provider:[a-z0-9][a-z0-9._-]*$"
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registration_revision": {
      "type": "integer",
      "minimum": 1
    },
    "compatibility_status": {
      "type": "string",
      "enum": [
        "COMPATIBLE",
        "INCOMPATIBLE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "catalog_revision": {
      "type": "string",
      "minLength": 1
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bundle_generation": {
      "type": "string",
      "minLength": 1
    },
    "bundle_state": {
      "type": "string",
      "enum": [
        "UNCONFIGURED",
        "STARTING",
        "READY",
        "DEGRADED",
        "UNAVAILABLE",
        "DISABLED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "C66; source=architecture/external-provider-contract-catalog-v1.md"
}
