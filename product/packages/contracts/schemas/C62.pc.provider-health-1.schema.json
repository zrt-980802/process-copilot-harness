{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C62.schema.json",
  "title": "C62 pc.provider-health/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "health_observation_id",
    "provider_registration_id",
    "configuration_revision",
    "provider_state",
    "compatibility_status",
    "port_health",
    "reason_codes",
    "evidence_refs",
    "checked_at",
    "expires_at"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.provider-health/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "health_observation_id": {
      "type": "string",
      "pattern": "^provider-health:[a-zA-Z0-9._-]+$"
    },
    "provider_registration_id": {
      "type": "string",
      "pattern": "^provider:[a-z0-9][a-z0-9._-]*$"
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 1
    },
    "provider_state": {
      "type": "string",
      "enum": [
        "UNCONFIGURED",
        "STARTING",
        "HEALTHY",
        "DEGRADED",
        "UNAVAILABLE",
        "DISABLED"
      ]
    },
    "compatibility_status": {
      "type": "string",
      "enum": [
        "COMPATIBLE",
        "INCOMPATIBLE",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "port_health": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "enum": [
            "UNCONFIGURED",
            "STARTING",
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "DISABLED"
          ]
        },
        "enterprise_authorization": {
          "type": "string",
          "enum": [
            "UNCONFIGURED",
            "STARTING",
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "DISABLED"
          ]
        },
        "project_directory": {
          "type": "string",
          "enum": [
            "UNCONFIGURED",
            "STARTING",
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "DISABLED"
          ]
        },
        "business_capability": {
          "type": "string",
          "enum": [
            "UNCONFIGURED",
            "STARTING",
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "DISABLED"
          ]
        },
        "workbench_projection": {
          "type": "string",
          "enum": [
            "UNCONFIGURED",
            "STARTING",
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "DISABLED"
          ]
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "C62; source=architecture/external-provider-contract-catalog-v1.md"
}
