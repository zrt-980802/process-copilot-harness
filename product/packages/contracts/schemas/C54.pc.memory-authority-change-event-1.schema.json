{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C54.schema.json",
  "title": "C54 pc.memory-authority-change-event/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "event_id",
    "tenant_id",
    "memory_id",
    "object_version",
    "change_kind",
    "object_state",
    "scope_digest",
    "sensitivity",
    "policy_revision",
    "occurred_at",
    "producer_sequence",
    "causation_command_id"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-authority-change-event/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "object_version": {
      "type": "integer",
      "minimum": 1
    },
    "change_kind": {
      "type": "string",
      "enum": [
        "CREATED",
        "CONFIRMED",
        "PUBLISHED",
        "REVISED",
        "SUPERSEDED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "object_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "CONFIRMED",
        "PUBLISHED",
        "REVOKED",
        "EXPIRED",
        "REJECTED"
      ]
    },
    "revision_state": {
      "type": "string",
      "enum": [
        "CURRENT",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "causation_command_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$comment": "C54; source=architecture/memory-contract-catalog-v1.md"
}
