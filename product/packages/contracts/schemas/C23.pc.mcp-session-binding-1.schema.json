{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C23.schema.json",
  "title": "C23 pc.mcp-session-binding/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "binding_id",
    "tenant_id",
    "principal_id",
    "pc_session_id",
    "connector_id",
    "mcp_server_id",
    "authorization_revision",
    "credential_generation",
    "tool_catalog_digest",
    "created_at",
    "expires_at",
    "state"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.mcp-session-binding/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "pc_session_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "mcp_server_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_session_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_revision": {
      "type": "integer",
      "minimum": 0
    },
    "credential_generation": {
      "type": "integer",
      "minimum": 0
    },
    "tool_catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "REAUTH_REQUIRED",
        "CLOSED",
        "EXPIRED"
      ]
    }
  },
  "$comment": "C23; source=architecture/stable-contract-catalog-v1.md"
}
