      "const": 1
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_principal_id": {
      "type": "string",
      "minLength": 1
