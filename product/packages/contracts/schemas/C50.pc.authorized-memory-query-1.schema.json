    "purpose": {
      "type": "string",
      "enum": [
        "PERSONALIZATION",
        "TASK_CONTINUITY",
        "DECISION_RECALL",
        "PROJECT_ASSISTANCE",
        "RUNBOOK_ASSISTANCE",
        "EMPLOYEE_REVIEW",
        "DELEGATE_RESPONSE"
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_release_id": {
      "type": "string",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "allowed_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_sensitivities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "valid_at": {
      "type": "string",
      "format": "date-time"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1
    },
    "max_context_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "projection_release_constraint": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
