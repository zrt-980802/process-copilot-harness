{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C46.schema.json",
  "title": "C46 pc.memory-capture-command/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "command_id",
    "idempotency_key",
    "request_context_ref",
    "capture_mode",
    "owner_principal_id",
    "scope_request",
    "memory_kind",
    "content",
    "source_evidence_inputs",
    "valid_time",
    "capture_policy_revision",
    "expected_result_state",
    "issued_at",
    "deadline"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-capture-command/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "request_context_ref": {
      "type": "string",
      "minLength": 1
    },
    "capture_mode": {
      "type": "string",
      "enum": [
        "EXPLICIT_USER_SAVE",
        "AUTOMATIC_CANDIDATE",
        "PROJECT_CANDIDATE",
        "SYSTEM_CANDIDATE"
      ]
    },
    "owner_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_type"
      ],
      "properties": {
        "scope_type": {
          "type": "string",
          "enum": [
            "PERSONAL",
            "PROJECT",
            "SYSTEM"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "memory_kind": {
      "type": "string",
      "enum": [
        "EXPLICIT_PREFERENCE",
        "CONFIRMED_FACT",
        "ONGOING_GOAL",
        "DECISION_HISTORY",
        "PROJECT_FACT",
        "RUNBOOK",
        "FAILURE_GOTCHA"
      ]
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "source_evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sensitivity_hint": {
      "type": "string",
      "minLength": 1
    },
    "capture_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "expected_result_state": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "CONFIRMED"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "C46; source=architecture/memory-contract-catalog-v1.md"
}
