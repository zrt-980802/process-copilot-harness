    "authorization_revision": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "exposed_at": {
      "type": "string",
      "format": "date-time"
    },
    "session_memory_state_after_exposure": {
      "type": "string",
      "enum": [
        "EXPOSED"
      ]
    }
  },
  "$comment": "C59; source=architecture/memory-contract-catalog-v1.md"
