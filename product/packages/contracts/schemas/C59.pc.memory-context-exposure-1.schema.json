{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C59.schema.json",
  "title": "C59 pc.memory-context-exposure/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "exposure_id",
    "tenant_id",
    "principal_id",
    "pc_session_id",
    "dsh_session_id",
    "assignment_generation",
    "turn_id",
    "authorized_view_id",
    "context_id",
    "context_digest",
    "memory_revision_refs",
    "authorization_revision",
    "policy_revision",
    "exposed_at",
    "session_memory_state_after_exposure"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-context-exposure/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "exposure_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "pc_session_id": {
      "type": "string",
      "minLength": 1
    },
    "dsh_session_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_generation": {
      "type": "integer",
      "minimum": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "authorized_view_id": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "context_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "memory_revision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
