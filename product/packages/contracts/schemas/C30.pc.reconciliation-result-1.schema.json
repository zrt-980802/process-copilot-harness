{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C30.schema.json",
  "title": "C30 pc.reconciliation-result/1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_name",
    "contract_version",
    "operation_id",
    "provider_facts",
    "resolved_outcome_state",
    "action",
    "evidence_refs",
    "reconciled_at"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.reconciliation-result/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_facts": {
      "type": "object",
      "additionalProperties": true
    },
    "resolved_outcome_state": {
      "type": "string",
      "enum": [
        "KNOWN_SUCCESS",
        "KNOWN_FAILURE",
        "NOT_STARTED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "RECORD_SUCCESS",
        "RECORD_FAILURE",
        "RETRY_SAME_KEY",
        "CONTINUE_RECONCILIATION",
        "REQUIRE_MANUAL",
        "CREATE_COMPENSATION"
      ]
    },
    "compensation_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "C30; source=architecture/stable-contract-catalog-v1.md"
}
