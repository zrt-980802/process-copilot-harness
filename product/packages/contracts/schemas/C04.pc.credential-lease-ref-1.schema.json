{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C04.schema.json",
  "title": "C04 pc.credential-lease-ref/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "credential_lease_id",
    "connector_id",
    "external_account_id",
    "credential_subject",
    "audience",
    "scope_digest",
    "generation",
    "expires_at",
    "binding_mode"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.credential-lease-ref/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "credential_lease_id": {
      "type": "string",
      "minLength": 1
    },
    "connector_id": {
      "type": "string",
      "minLength": 1
    },
    "external_account_id": {
      "type": "string",
      "minLength": 1
    },
    "credential_subject": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "binding_mode": {
      "type": "string",
      "enum": [
        "bearer",
        "dpop",
        "mtls"
      ]
    }
  },
  "$comment": "C04; source=architecture/stable-contract-catalog-v1.md"
}
