{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C58.schema.json",
  "title": "C58 pc.memory-policy-decision/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "decision_id",
    "decision_kind",
    "tenant_id",
    "principal_id",
    "authorization_revision",
    "policy_revision",
    "decision",
    "reason_codes",
    "evidence_refs",
    "decided_at",
    "decision_digest"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-policy-decision/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_kind": {
      "type": "string",
      "enum": [
        "CAPTURE",
        "QUERY",
        "REVISE",
        "REVOKE",
        "CONTEXT_ASSEMBLY"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "PERSONALIZATION",
        "TASK_CONTINUITY",
        "DECISION_RECALL",
        "PROJECT_ASSISTANCE",
        "RUNBOOK_ASSISTANCE",
        "EMPLOYEE_REVIEW",
        "DELEGATE_RESPONSE"
      ]
    },
    "authorization_revision": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_CONFIRMATION",
        "REQUIRE_REDACTION",
        "REQUIRE_ESCALATION"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$comment": "C58; source=architecture/memory-contract-catalog-v1.md"
}
