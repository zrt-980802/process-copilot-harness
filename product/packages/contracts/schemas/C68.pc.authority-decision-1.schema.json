{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C68.schema.json",
  "title": "C68 pc.authority-decision/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "decision_id",
    "principal_id",
    "pc_session_id",
    "tenant_id",
    "logical_request_id",
    "action",
    "resource_ref",
    "resource_authority",
    "decision_mode",
    "pc_policy_revision",
    "identity_revision",
    "pc_decision",
    "pc_scope_decision",
    "decision",
    "reason_codes",
    "evidence_refs",
    "observed_at",
    "expires_at",
    "decision_digest"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.authority-decision/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "pc_session_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_request_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:[.:][a-z0-9_-]+)+$"
    },
    "resource_ref": {
      "type": "string",
      "minLength": 1
    },
    "resource_authority": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "decision_mode": {
      "type": "string",
      "enum": [
        "PC_ONLY",
        "PC_AND_PROVIDER",
        "DENY_UNKNOWN"
      ]
    },
    "pc_policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "identity_revision": {
      "type": "integer",
      "minimum": 1
    },
    "pc_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "UNKNOWN"
      ]
    },
    "pc_scope_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "UNKNOWN"
      ]
    },
    "provider_registration_id": {
      "type": "string",
      "pattern": "^provider:[a-z0-9][a-z0-9._-]*$"
    },
    "provider_bundle_generation": {
      "type": "string",
      "minLength": 1
    },
    "provider_mapping_release_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "provider_decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "UNKNOWN"
      ]
    },
    "provider_decision_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(pc|provider-call|provider-decision):[a-zA-Z0-9._:-]+$"
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$comment": "C68; source=architecture/external-provider-contract-catalog-v1.md",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_mode": {
            "const": "PC_ONLY"
          }
        }
      },
      "then": {
        "properties": {
          "provider_registration_id": false,
          "provider_bundle_generation": false,
          "provider_mapping_release_id": false,
          "provider_decision_ref": false,
          "provider_decision": false,
          "provider_decision_observed_at": false,
          "resource_authority": {
            "const": "pc"
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^pc:[a-zA-Z0-9._:-]+$"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_mode": {
            "const": "DENY_UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": "DENY"
          },
          "provider_registration_id": false,
          "provider_bundle_generation": false,
          "provider_mapping_release_id": false,
          "provider_decision_ref": false,
          "provider_decision": false,
          "provider_decision_observed_at": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_mode": {
            "const": "PC_AND_PROVIDER"
          }
        }
      },
      "then": {
        "properties": {
          "resource_authority": {
            "not": {
              "const": "pc"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ALLOW"
          }
        }
      },
      "then": {
        "properties": {
          "pc_decision": {
            "const": "ALLOW"
          },
          "pc_scope_decision": {
            "const": "ALLOW"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision_mode": {
                  "const": "PC_AND_PROVIDER"
                }
              }
            },
            "then": {
              "required": [
                "provider_registration_id",
                "provider_bundle_generation",
                "provider_mapping_release_id",
                "provider_decision_ref",
                "provider_decision",
                "provider_decision_observed_at"
              ],
              "properties": {
                "provider_decision": {
                  "const": "ALLOW"
                }
              }
            }
          }
        ]
      }
    }
  ]
}
