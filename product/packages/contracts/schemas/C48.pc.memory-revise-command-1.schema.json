{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C48.schema.json",
  "title": "C48 pc.memory-revise-command/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "command_id",
    "idempotency_key",
    "memory_id",
    "expected_object_version",
    "expected_current_revision_id",
    "revision_reason",
    "new_content",
    "new_source_evidence_inputs",
    "new_valid_time",
    "principal_id",
    "authorization_revision",
    "policy_revision",
    "issued_at",
    "deadline"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-revise-command/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_object_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_current_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_reason": {
      "type": "string",
      "enum": [
        "CORRECTION",
        "TEMPORAL_CHANGE",
        "CONTENT_UPDATE",
        "SCOPE_CHANGE",
        "SENSITIVITY_CHANGE"
      ]
    },
    "new_content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "new_source_evidence_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1
      }
    },
    "new_valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope_adjustment": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "sensitivity_adjustment": {
      "type": "string",
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_revision": {
      "type": "integer",
      "minimum": 0
    },
    "policy_revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "C48; source=architecture/memory-contract-catalog-v1.md"
}
