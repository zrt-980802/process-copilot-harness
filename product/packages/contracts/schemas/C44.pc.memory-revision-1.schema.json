{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.process-copilot.local/v1/C44.schema.json",
  "title": "C44 pc.memory-revision/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "revision_id",
    "memory_id",
    "revision_no",
    "revision_state",
    "structured_content",
    "retrieval_summary",
    "source_evidence_ids",
    "confidence",
    "valid_from",
    "recorded_at",
    "created_by_principal_id",
    "creation_reason",
    "content_digest",
    "schema_revision"
  ],
  "properties": {
    "contract_name": {
      "const": "pc.memory-revision/1"
    },
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_no": {
      "type": "integer",
      "minimum": 1
    },
    "revision_state": {
      "type": "string",
      "enum": [
        "CURRENT",
        "SUPERSEDED",
        "WITHDRAWN"
      ]
    },
    "structured_content": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "retrieval_summary": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_principal_id": {
      "type": "string",
      "minLength": 1
    },
    "creation_reason": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$comment": "C44; source=architecture/memory-contract-catalog-v1.md"
}
